# Cloudflare R2 Storage
# Server-only credentials for private documents (payment slips, tenant contracts)
R2_ACCOUNT_ID=
R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_PRIVATE_BUCKET_NAME=longtua-private-assets
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=

# Public CDN domain for brand logo and public static media
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://<public-r2-domain>.r2.dev

# PostgreSQL Database (Server-only)
# Supabase Transaction Pooler (Port 6543) or Direct PostgreSQL (Port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Native Session HMAC Secret (Server-only 32+ random characters for signing session tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# Synthetic email domain used internally to let customers sign in with username
AUTH_INTERNAL_EMAIL_DOMAIN=auth.longtua.com

# Public website and Apartment application boundaries
MARKETING_REGISTRATION_URL=https://longtua.com/apartment/register
LONGTUA_SUPPORT_URL=https://longtua.com/contact
APARTMENT_APP_URL=https://apartment.longtua.com

# Shared API secrets with marketing website (longtua.com)
TRIAL_REQUEST_API_SECRET=
LONGTUA_PUBLIC_API_KEY=

# Health check (server-only)
# /api/health requires Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Migration helpers (Optional: needed only by scripts/migrate-slips-to-r2.mjs for one-time legacy slip migration)
# SUPABASE_MIGRATION_URL=
# SUPABASE_MIGRATION_SERVICE_KEY=
