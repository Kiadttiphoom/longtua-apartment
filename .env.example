# Cloudflare R2
# Server-only values. Do not prefix credentials with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_S3_ENDPOINT=
R2_REGION=auto

# Public assets: LONGTUA logo, icons, favicon, and public media
R2_PUBLIC_BUCKET_NAME=longtua-public-assets
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# Private assets: tenant documents, contracts, payment evidence, and reports
R2_PRIVATE_BUCKET_NAME=longtua-private-assets
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=

# Presigned URL lifetime in seconds
R2_PUBLIC_UPLOAD_URL_TTL_SECONDS=900
R2_PRIVATE_UPLOAD_URL_TTL_SECONDS=900
R2_PRIVATE_DOWNLOAD_URL_TTL_SECONDS=900

# Upload limits in bytes
R2_PUBLIC_MAX_UPLOAD_BYTES=5242880
R2_PRIVATE_MAX_UPLOAD_BYTES=10485760
